# -----------------------------------------------------------------------------
# Telegram AI Executive Assistant - Environment Configuration Template
# -----------------------------------------------------------------------------

# Telegram Control Bot Token (created via @BotFather on Telegram)
# This bot serves as your private administrative cockpit.
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_1234567

# Owner's Telegram User ID (obtain from @userinfobot)
# Strict OwnerOnly filter ensures only this Telegram ID can interact with the bot.
OWNER_TELEGRAM_ID=987654321

# Symmetric Cryptography Encryption Key (Fernet, 32-byte URL-safe base64)
# Used to encrypt MTProto session strings, api_hash, and LLM API keys at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_base64_key_here=

# Async Database Connection String
# Defaults to local SQLite via aiosqlite inside data/ directory
DATABASE_URL=sqlite+aiosqlite:///data/app.db
